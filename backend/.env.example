# Local development bypasses rate limits. Production deployments must set this to "production" or rate limits will not apply.
NODE_ENV=development

# Add your Brevo API key locally and in Render's environment settings.
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=4 THE PEOPLE

# FRONTEND_URL is used to build links in emails; keep it to one frontend URL.
FRONTEND_URL=http://localhost:5173
# Add the exact origins allowed to call the API, separated by commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required only when running `node seed.js`.
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
